{
  "slug": "slider",
  "title": "Slider",
  "group": "Data Entry",
  "sections": [
    {
      "section": "Slider",
      "rows": [
        {
          "prop": "classNames",
          "desc": "Customize class for each semantic structure inside the component. Supports object or function.",
          "type": "Record<SemanticDOM, string> | (info: { props })=> Record<SemanticDOM, string>",
          "default": "-",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "defaultValue",
          "desc": "The default value of the slider. When range is false, use number, otherwise, use [number, number]",
          "type": "number | [number, number]",
          "default": "0 | [0, 0]",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "disabled",
          "desc": "If true, the slider will not be interactive. This prop can also be an array to disable specific handles in range mode, e.g. [true, false, true] disables first and third handles. When any rendered handle is disabled, editable mode will be disabled",
          "type": "boolean | boolean[]",
          "default": "false",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "keyboard",
          "desc": "Support using keyboard to move handlers",
          "type": "boolean",
          "default": "true",
          "version": "5.2.0+",
          "deprecated": false
        },
        {
          "prop": "dots",
          "desc": "Whether the thumb can only be dragged to tick marks",
          "type": "boolean",
          "default": "false",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "included",
          "desc": "Takes effect when marks is not null. True means containment and false means coordinative",
          "type": "boolean",
          "default": "true",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "marks",
          "desc": "Tick marks of Slider. The type of key must be number, and must be in closed interval [min, max]. Each mark can declare its own style",
          "type": "object",
          "default": "{ number: ReactNode } | { number: { style: CSSProperties, label: ReactNode } }",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "max",
          "desc": "The maximum value the slider can slide to",
          "type": "number",
          "default": "100",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "min",
          "desc": "The minimum value the slider can slide to",
          "type": "number",
          "default": "0",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "orientation",
          "desc": "Orientation",
          "type": "horizontal | vertical",
          "default": "horizontal",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "range",
          "desc": "Enable dual thumb mode for range selection",
          "type": "boolean | range",
          "default": "false",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "reverse",
          "desc": "Reverse the component",
          "type": "boolean",
          "default": "false",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "startPoint",
          "desc": "Starting value of the filled track in single-handle mode",
          "type": "number",
          "default": "min",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "step",
          "desc": "The granularity the slider can step through values. Must be greater than 0, and be divisible by (max - min). When step is null and marks exist, valid points will only be marks, min and max",
          "type": "number | null",
          "default": "1",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "styles",
          "desc": "Customize inline style for each semantic structure inside the component. Supports object or function.",
          "type": "Record<SemanticDOM, CSSProperties> | (info: { props })=> Record<SemanticDOM, CSSProperties>",
          "default": "-",
          "version": "",
          "deprecated": false
        },
        {
