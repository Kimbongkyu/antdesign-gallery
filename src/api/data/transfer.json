{
  "slug": "transfer",
  "title": "Transfer",
  "group": "Data Entry",
  "sections": [
    {
      "section": "Transfer",
      "rows": [
        {
          "prop": "actions",
          "desc": "A set of operations that are sorted from top to bottom. When an array of strings is provided, default buttons will be used; when an array of ReactNode is provided, custom elements will be used",
          "type": "ReactNode[]",
          "default": "[>, <]",
          "version": "6.0.0",
          "deprecated": false
        },
        {
          "prop": "classNames",
          "desc": "Customize class for each semantic structure inside the component. Supports object or function.",
          "type": "Record<SemanticDOM, string> | (info: { props })=> Record<SemanticDOM, string>",
          "default": "-",
          "version": "6.0.0",
          "deprecated": false
        },
        {
          "prop": "dataSource",
          "desc": "Used for setting the source data. The elements that are part of this array will be present the left column. Except the elements whose keys are included in targetKeys prop",
          "type": "RecordType extends TransferItem = TransferItem[]",
          "default": "[]",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "disabled",
          "desc": "Whether disabled transfer",
          "type": "boolean",
          "default": "false",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "selectionsIcon",
          "desc": "custom dropdown icon",
          "type": "React.ReactNode",
          "default": "",
          "version": "5.8.0",
          "deprecated": false
        },
        {
          "prop": "filterOption",
