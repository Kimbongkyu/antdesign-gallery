          "desc": "A set of keys of elements that are listed on the right column",
          "type": "string[] | number[]",
          "default": "[]",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "titles",
          "desc": "A set of titles that are sorted from left to right",
          "type": "ReactNode[]",
          "default": "-",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "onChange",
          "desc": "A callback function that is executed when the transfer between columns is complete",
          "type": "(targetKeys, direction, moveKeys): void",
          "default": "-",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "onScroll",
          "desc": "A callback function which is executed when scroll options list",
          "type": "(direction, event): void",
          "default": "-",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "onSearch",
          "desc": "A callback function which is executed when search field are changed",
          "type": "(direction: left | right, value: string): void",
          "default": "-",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "onSelectChange",
          "desc": "A callback function which is executed when selected items are changed",
          "type": "(sourceSelectedKeys, targetSelectedKeys): void",
          "default": "-",
          "version": "",
          "deprecated": false
        }
      ]
    },
