          "type": "(inputValue, option, direction: left | right): boolean",
          "default": "-",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "footer",
          "desc": "A function used for rendering the footer",
          "type": "(props, { direction }) => ReactNode",
          "default": "-",
          "version": "direction: 4.17.0",
          "deprecated": false
        },
        {
          "prop": "listStyle",
          "desc": "A custom CSS style used for rendering the transfer columns. Use styles.section instead",
          "type": "object | ({direction: left | right}) => object",
          "default": "-",
          "version": "",
          "deprecated": true
        },
        {
          "prop": "locale",
          "desc": "The i18n text including filter, empty text, item unit, etc",
          "type": "{ itemUnit: string; itemsUnit: string; searchPlaceholder: string; notFoundContent: ReactNode | ReactNode[]; }",
          "default": "{ itemUnit: item, itemsUnit: items, notFoundContent: No data, searchPlaceholder: Search here }",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "oneWay",
          "desc": "Display as single direction style",
          "type": "boolean",
          "default": "false",
          "version": "4.3.0",
          "deprecated": false
        },
        {
          "prop": "operations",
          "desc": "A set of operations that are sorted from top to bottom. Use actions instead.",
          "type": "string[]",
          "default": "[>, <]",
          "version": "",
          "deprecated": true
        },
        {
          "prop": "operationStyle",
          "desc": "A custom CSS style used for rendering the operations column. Use styles.actions instead.",
          "type": "object",
          "default": "-",
          "version": "",
          "deprecated": true
        },
        {
          "prop": "pagination",
          "desc": "Use pagination. Not work in render props",
          "type": "boolean | { pageSize: number, simple: boolean, showSizeChanger?: boolean, showLessItems?: boolean }",
          "default": "false",
          "version": "4.3.0",
          "deprecated": false
        },
        {
          "prop": "render",
          "desc": "The function to generate the item shown on a column. Based on an record (element of the dataSource array), this function should return a React element which is generated from that record. Also, it can return a plain object with value and label, label is a React element and value is for title",
          "type": "(record) => ReactNode",
          "default": "-",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "selectAllLabels",
          "desc": "A set of customized labels for select all checkboxes on the header",
          "type": "(ReactNode | (info: { selectedCount: number, totalCount: number }) => ReactNode)[]",
          "default": "-",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "selectedKeys",
          "desc": "A set of keys of selected items",
          "type": "string[] | number[]",
          "default": "[]",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "showSearch",
          "desc": "If included, a search box is shown on each column",
          "type": "boolean | { placeholder:string,defaultValue:string }",
          "default": "false",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "showSelectAll",
          "desc": "Show select all checkbox on the header",
          "type": "boolean",
          "default": "true",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "status",
