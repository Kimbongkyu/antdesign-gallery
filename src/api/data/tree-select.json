          "default": "TreeSelect.SHOW_CHILD",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "showSearch",
          "desc": "Support search or not",
          "type": "boolean | Object",
          "default": "single: false | multiple: true",
          "version": "",
          "deprecated": false
