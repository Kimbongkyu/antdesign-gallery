          "type": "string[]",
          "default": "[]",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "defaultExpandParent",
          "desc": "If auto expand parent treeNodes when init",
          "type": "boolean",
          "default": "true",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "defaultSelectedKeys",
          "desc": "Specifies the keys of the default selected treeNodes",
          "type": "string[]",
          "default": "[]",
          "version": "",
          "deprecated": false
        },
        {
