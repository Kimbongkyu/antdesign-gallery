          "type": "string | AcceptObject",
          "default": "-",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "action",
          "desc": "Uploading URL",
          "type": "string | (file) => Promise&lt;string>",
          "default": "-",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "beforeUpload",
          "desc": "Hook function which will be executed before uploading. Uploading will be stopped with false or a rejected Promise returned. When returned value is Upload.LIST_IGNORE, the list of files that have been uploaded will ignore it. **Warning：this function is not supported in IE9**",
          "type": "(file: RcFile, fileList: [RcFile[]](#rcfile)) => boolean | Promise&lt;File> | Upload.LIST_IGNORE",
          "default": "-",
          "version": "",
          "deprecated": false
        },
        {
          "prop": "customRequest",
          "desc": "Override for the default xhr behavior allowing for additional customization and the ability to implement your own XMLHttpRequest",
          "type": "( options: RequestOptions, info: { defaultRequest: (option: RequestOptions) => void | { abort: () => void }; } ) => void | { abort: () => void }",
          "default": "-",
          "version": "defaultRequest: 5.28.0",
          "deprecated": false
        },
        {
          "prop": "classNames",
